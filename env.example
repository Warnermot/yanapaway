# Copiar este archivo a `.env` en la raíz del repo y completar los valores
# reales antes de levantar `docker compose up`. `.env` nunca se versiona
# (ver .gitignore) — ningún secreto real debe vivir en este archivo de
# ejemplo ni en el código fuente.
#
#   cp env.example .env
#
# Nota: por las reglas de permisos de este entorno de desarrollo, el asistente
# no puede leer ni escribir archivos `.env*` directamente — este template
# se entrega sin el punto inicial a propósito. Renombralo vos mismo.

# ---- Base de datos (Postgres 16, servicio "db" del compose) ----
DATABASE_NAME=yanapaway_cms
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=cambiar-por-una-contrasena-fuerte
DATABASE_SSL=false

# ---- Secretos de Strapi ----
# Generar cada uno con: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# APP_KEYS admite varias claves separadas por coma (mínimo 2 recomendadas).
APP_KEYS=clave1,clave2
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ---- Regla de negocio: vigencia de verificación de instituciones ----
# Días máximos permitidos entre `verificadoEn` y hoy para poder publicar
# o mantener publicada una institución. Brief: 180.
VERIFICACION_MAX_DIAS=180

# ---- Webhook de reconstrucción del sitio Astro ----
# Si se deja vacío, el CMS loguea y no dispara ninguna reconstrucción.
REBUILD_WEBHOOK_URL=
REBUILD_WEBHOOK_SECRET=
# Agrupación de ráfagas de publicación (opcional; defaults en ms).
# Varias publicaciones dentro de REBUILD_DEBOUNCE_MS se juntan en una sola
# reconstrucción; REBUILD_MAX_WAIT_MS es el tope ante actividad continua.
# REBUILD_DEBOUNCE_MS=60000
# REBUILD_MAX_WAIT_MS=300000

# ---- Token de API de solo lectura (opcional) ----
# Si se define, el bootstrap intenta crear/asegurar un admin::api-token
# de tipo read-only con este valor, para que dev/staging sean reproducibles.
# En producción, preferir crearlo a mano desde el panel y no setear esto.
SEED_READONLY_API_TOKEN=

# ---- Token de integración con apps/web (opcional) ----
# Si se define (cualquier valor no vacío), el bootstrap crea, la primera vez,
# un api-token tipo "Custom" con permisos de lectura sobre
# institucion/sede-institucion/tipo-caso/pagina/categoria-recurso, de lectura
# y creación sobre el blog de historias, y de creación sobre
# solicitud-orientacion -- es el único acceso que necesita el sitio Astro
# (apps/web), que ahora usa Strapi como fuente de verdad en vez de su propio
# Postgres/Drizzle. El valor real del token se genera solo y se loguea UNA
# VEZ al crearlo; copiarlo a apps/web/.env como STRAPI_API_TOKEN. En
# producción, preferir crearlo a mano desde el panel.
# La lista exacta de permisos vive en
# apps/cms/src/bootstrap/token-integracion-web.ts.
SEED_WEB_API_TOKEN=

# ---- Sitio en producción (perfil "prod" de docker-compose) ----
# El servicio web-prod corre el sitio como servidor Node (output: 'server'), así
# que necesita estas variables en tiempo de ejecución. En dev no hacen falta
# acá: el servicio "web" monta el repo y toma apps/web/.env.
#
# Token de integración generado por el CMS (el mismo valor que va en
# apps/web/.env como STRAPI_API_TOKEN).
STRAPI_API_TOKEN=
# URL del CMS tal como la ve el NAVEGADOR de quien visita el sitio (el diario y
# el asistente hablan directo con el CMS). Debe ser pública y con HTTPS.
PUBLIC_CMS_URL=
# URL del CMS tal como la ve el servidor del sitio. Por defecto usa la red
# interna de compose y no hace falta cambiarla.
# STRAPI_URL=http://cms-prod:1337
# Sal para la huella de origen de la moderación de /blog. Cadena larga y
# aleatoria. Si queda vacía, no se guarda ninguna huella: un sha256 de una IP
# sin sal (o con una sal conocida) se revierte por fuerza bruta en segundos, así
# que se prefiere no guardar nada antes que guardar un dato personal disfrazado
# de anónimo. Ver apps/web/src/lib/hash-ip.ts.
HASH_SALT=
