---
import TarjetaRecurso from './recursos/TarjetaRecurso.astro';
import { listarPaginasRecursos, type PaginaRecurso } from '../lib/recursos';
import { useTranslations, defaultLang, type Lang } from '../i18n/utils';

interface Props {
	lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

// Vitrina de recursos en el home; el listado completo (agrupado por
// categoría) vive en /recursos. Si el CMS no responde, la sección se oculta
// sola: es peor mostrar una landing que revienta que una landing más corta.
let paginas: PaginaRecurso[] = [];
let cmsCaido = false;

try {
	paginas = (await listarPaginasRecursos()).slice(0, 6);
} catch (error) {
	cmsCaido = true;
	console.error('[home] No se pudieron cargar recursos desde el CMS:', error);
}
---

<section class="content-section" id="contenido">
	<div class="wrapper">
		<h2 class="section-heading">{t('content.heading')}</h2>

		{
			!cmsCaido && paginas.length > 0 && (
				<div class="content-grid">
					{paginas.map((pagina, indice) => (
						<TarjetaRecurso pagina={pagina} indice={indice} />
					))}
				</div>
			)
		}

		<a href="/recursos" class="pill-btn content-ver-todos">
			{t('content.viewAll')}
		</a>
	</div>
</section>

<style>
	.content-section {
		padding-block: 4.5rem;
		background: var(--color-support-teal-tint);
	}

	.content-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
		margin-bottom: 2rem;
	}

	.content-ver-todos {
		background: var(--color-secondary);
		color: white;
		padding: 0.7rem 1.8rem;
		font-weight: 500;
	}

	@media (max-width: 860px) {
		.content-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 540px) {
		.content-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
