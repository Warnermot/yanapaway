---
import { normalizarBloques, inlineDe, textoDe, etiquetaTitulo } from '../../lib/bloques';
import { urlAbsolutaDeMedia } from '../../lib/media';
import TextoInline from './TextoInline.astro';
import ListaBloques from './ListaBloques.astro';

interface Props {
	bloques: unknown;
}

// El campo `contenido` de Página es el editor de bloques de Strapi. Nunca es
// HTML (ver la descripción del atributo en apps/cms): se recorre el árbol de
// nodos y se descarta lo que este sitio todavía no sabe pintar.
const bloques = normalizarBloques(Astro.props.bloques);
---

<div class="contenido-bloques">
	{
		bloques.map((bloque) => {
			switch (bloque.type) {
				case 'heading': {
					const Titulo = etiquetaTitulo(bloque.level);
					return (
						<Titulo>
							<TextoInline nodos={inlineDe(bloque)} />
						</Titulo>
					);
				}
				case 'list':
					return <ListaBloques lista={bloque} />;
				case 'quote':
					return (
						<blockquote>
							<TextoInline nodos={inlineDe(bloque)} />
						</blockquote>
					);
				case 'code':
					return (
						<pre>
							<code>{textoDe(bloque)}</code>
						</pre>
					);
				case 'image':
					return (
						<img
							src={urlAbsolutaDeMedia(bloque.image.url)}
							alt={bloque.image.alternativeText ?? ''}
							width={bloque.image.width}
							height={bloque.image.height}
							loading="lazy"
						/>
					);
				default:
					return (
						<p>
							<TextoInline nodos={inlineDe(bloque)} />
						</p>
					);
			}
		})
	}
</div>

<style>
	.contenido-bloques {
		display: flex;
		flex-direction: column;
		gap: 1.15rem;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-ink);
	}

	.contenido-bloques :global(h2),
	.contenido-bloques :global(h3),
	.contenido-bloques :global(h4),
	.contenido-bloques :global(h5),
	.contenido-bloques :global(h6) {
		margin-top: 1rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.contenido-bloques :global(h2) {
		font-size: 1.35rem;
	}

	.contenido-bloques :global(h3) {
		font-size: 1.15rem;
	}

	.contenido-bloques :global(blockquote) {
		border-left: 4px solid var(--color-secondary);
		padding: 0.35rem 0 0.35rem 1rem;
		color: var(--color-ink-soft);
		font-style: italic;
	}

	.contenido-bloques :global(pre) {
		background: var(--color-cream-dark);
		border-radius: var(--radius-m);
		padding: 1rem 1.15rem;
		overflow-x: auto;
		font-size: 0.9rem;
	}

	.contenido-bloques :global(img) {
		max-width: 100%;
		height: auto;
		border-radius: var(--radius-m);
	}
</style>
