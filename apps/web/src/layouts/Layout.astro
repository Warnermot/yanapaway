---
import '../styles/global.css';
import SosButton from '../components/SosButton.astro';
import { defaultLang, type Lang } from '../i18n/utils';

interface Props {
	title?: string;
	description?: string;
	lang?: Lang;
}

const {
	title = 'yanapaway — No estás sola',
	description = 'No estás sola. No es tu culpa. Encuentra apoyo seguro, ahora mismo.',
	lang = defaultLang,
} = Astro.props;

// El atributo lang del <html> usa códigos BCP 47; "qu" (quechua) es válido tal cual.
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<SosButton lang={lang} />
	</body>
</html>
