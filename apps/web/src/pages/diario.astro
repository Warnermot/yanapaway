---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SelectorEmocion from '../components/SelectorEmocion.astro';
import LoginButton from '../components/LoginButton.astro';

// URL base del CMS Strapi (configurable con PUBLIC_CMS_URL)
const CMS_URL = import.meta.env.PUBLIC_CMS_URL ?? 'http://localhost:1337';
---

<Layout title="Yanapa — Diario personal" description="Tu diario personal privado: registra cómo te sientes cada día.">
	<Navbar />
	<main class="diario-wrapper wrapper">
		<!-- Puerta de login — visible si no hay sesión de Firebase -->
		<!-- Tarjeta centrada — visible solo SIN sesión -->
		<div id="login-gate-centrado" class="login-gate-centrado" hidden>
			<div class="login-card-centrada">
				<span class="login-card-icon">🔒</span>
				<h2>Tu diario personal</h2>
				<p>Inicia sesión con Google para acceder a tu diario de forma segura. Solo tú puedes ver lo que escribes aquí.</p>
				<LoginButton />
			</div>
		</div>

		<!-- Barra de sesión compacta — visible solo CON sesión -->
		<div id="barra-sesion" class="barra-sesion" hidden>
			<span class="barra-sesion-icon">🔒</span>
			<span class="barra-sesion-nombre" id="barra-sesion-nombre"></span>
			<button type="button" id="btn-cerrar-sesion" class="btn-logout pill-btn">Cerrar sesión</button>
		</div>

		<!-- Contenido del diario — visible solo con sesión activa -->
		<div id="contenido-diario" hidden>
		<div class="diario-layout">
			<section class="nueva-entrada">
				<h2>¿Cómo estás hoy?</h2>

				<SelectorEmocion id="selector-emocion" onChange="onSeleccionEmocionDiario" />

				<textarea
					id="texto-entrada"
					placeholder="Escribe lo que sientes..."
					rows="8"
				></textarea>

				<div class="selector-etiquetas" id="selector-etiquetas" aria-label="Etiquetas">
					<!-- chips de etiquetas clicables (cargados por JS) -->
				</div>

				<div class="acciones-entrada">
					<button type="button" id="btn-guardar" class="pill-btn">Guardar entrada</button>
					<p class="mensaje-estado" id="mensaje-estado" role="status"></p>
				</div>

				<nav class="modulos-nav" aria-label="Módulos personales">
					<a href="/asistente" class="pill-btn nav-modulo">Hablar con tu asistente</a>
				</nav>
			</section>

			<section class="historial-entradas">
				<h3>Tus entradas anteriores</h3>
				<div class="lista-entradas" id="lista-entradas">
					<p class="historial-vacio" id="historial-vacio">Aún no tienes entradas. Cuando escribas la primera, aparecerá aquí.</p>
				</div>
			</section>
		</div>
		</div>
	</main>

	<!-- Modal global de confirmación de eliminación — tonos neutros, sin rojos (RD-01) -->
	<div class="modal-eliminar" id="modal-eliminar-global" hidden role="dialog" aria-modal="true" aria-label="Confirmar eliminación">
		<div class="modal-caja">
			<p class="modal-texto">¿Eliminar esta entrada? Esta acción no se puede deshacer.</p>
			<div class="modal-acciones">
				<button type="button" class="btn-cancelar" id="btn-cancelar-eliminar">Cancelar</button>
				<button type="button" class="btn-confirmar" id="btn-confirmar-eliminar">Eliminar</button>
			</div>
		</div>
	</div>

	<Footer />
</Layout>

<script is:inline define:vars={{ CMS_URL }}>
	(function () {
		const API = `${CMS_URL}/api`;

		// Verificar autenticación — el diario requiere sesión con Firebase
		const firebaseUserRaw = localStorage.getItem('yanapaway_firebase_user');
		const isLoggedIn = !!firebaseUserRaw;
		if (isLoggedIn) {
			// Con sesión: barra compacta + diario completo
			document.getElementById('barra-sesion').hidden = false;
			document.getElementById('contenido-diario').hidden = false;
		} else {
			// Sin sesión: tarjeta centrada, el diario oculto
			document.getElementById('login-gate-centrado').hidden = false;
			return; // No seguir: solo se muestra la tarjeta de login
		}

		// Identificador de usuario con Firebase Auth (SEC-01).
		// Si el usuario inició sesión con Google → hash determinista de su UID.
		// Si no → fallback al ID aleatorio anterior (compatible hacia atrás).
		function obtenerUsuarioId() {
			const raw = localStorage.getItem('yanapaway_firebase_user');
			if (raw) {
				try {
					const user = JSON.parse(raw);
					if (user.uid) {
						let hash = 0;
						for (let i = 0; i < user.uid.length; i++) {
							hash = ((hash << 5) - hash) + user.uid.charCodeAt(i);
							hash = hash | 0;
						}
						return Math.abs(hash);
					}
				} catch (_) {}
			}
			const clave = 'yanapaway_usuario_id';
			let id = Number(localStorage.getItem(clave));
			if (!id) {
				id = Math.floor(Math.random() * 1_000_000) + 1;
				localStorage.setItem(clave, String(id));
			}
			return id;
		}

		const usuarioId = obtenerUsuarioId();

		const EMOJIS = {
			muy_bien: '😊',
			bien: '🙂',
			neutral: '😐',
			mal: '😔',
			muy_mal: '😢',
		};

		const SVG_PAPELERA =
			'<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"></path><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" x2="10" y1="11" y2="17"></line><line x1="14" x2="14" y1="11" y2="17"></line></svg>';

		const selectorEtiquetas = document.getElementById('selector-etiquetas');
		const textoEntrada = document.getElementById('texto-entrada');
		const btnGuardar = document.getElementById('btn-guardar');
		const mensajeEstado = document.getElementById('mensaje-estado');
		const listaEntradas = document.getElementById('lista-entradas');
		const historialVacio = document.getElementById('historial-vacio');
		const modal = document.getElementById('modal-eliminar-global');
		const btnCancelarEliminar = document.getElementById('btn-cancelar-eliminar');
		const btnConfirmarEliminar = document.getElementById('btn-confirmar-eliminar');

		let emocionSeleccionada = null;
		const etiquetasSeleccionadas = new Set();
		let documentIdPendienteEliminar = null;

		// Callback del componente SelectorEmocion (USE-01: botones emoji, no <select>)
		window.onSeleccionEmocionDiario = function (valor) {
			emocionSeleccionada = valor;
		};

		function mostrarEstado(texto) {
			mensajeEstado.textContent = texto;
			setTimeout(() => {
				if (mensajeEstado.textContent === texto) mensajeEstado.textContent = '';
			}, 4000);
		}

		// --- Etiquetas disponibles ---
		async function cargarEtiquetas() {
			try {
				const res = await fetch(`${API}/etiquetas-diario`);
				const json = await res.json();
				const etiquetas = json.data ?? [];
				selectorEtiquetas.innerHTML = '';
				for (const et of etiquetas) {
					const chip = document.createElement('button');
					chip.type = 'button';
					chip.className = 'chip-etiqueta chip-seleccionable';
					chip.textContent = et.nombre;
					chip.dataset.documentId = et.documentId;
					if (et.color) chip.style.background = et.color;
					chip.addEventListener('click', () => {
						const id = chip.dataset.documentId;
						if (etiquetasSeleccionadas.has(id)) {
							etiquetasSeleccionadas.delete(id);
							chip.classList.remove('seleccionada');
						} else {
							etiquetasSeleccionadas.add(id);
							chip.classList.add('seleccionada');
						}
					});
					selectorEtiquetas.appendChild(chip);
				}
			} catch (error) {
				console.error('No se pudieron cargar las etiquetas:', error);
			}
		}

		// --- Historial (SEC-01: siempre filtrado por usuarioId) ---
		function construirTarjeta(entrada) {
			const fechaLegible = new Date(entrada.fecha).toLocaleDateString('es-ES', {
				weekday: 'long',
				year: 'numeric',
				month: 'long',
				day: 'numeric',
			});

			const textoPlano = String(entrada.texto ?? '')
				.replace(/<[^>]*>/g, ' ')
				.replace(/\s+/g, ' ')
				.trim();
			const palabras = textoPlano.split(' ').filter(Boolean);
			const extracto = palabras.length > 100 ? palabras.slice(0, 100).join(' ') + '…' : textoPlano;

			const tarjeta = document.createElement('article');
			tarjeta.className = 'tarjeta-diario';
			tarjeta.dataset.documentId = entrada.documentId;

			const cabecera = document.createElement('header');
			cabecera.className = 'tarjeta-cabecera';

			const emoji = document.createElement('span');
			emoji.className = 'tarjeta-emoji';
			emoji.setAttribute('aria-hidden', 'true');
			emoji.textContent = EMOJIS[entrada.emocion] ?? '😐';

			const fecha = document.createElement('time');
			fecha.className = 'tarjeta-fecha';
			fecha.dateTime = entrada.fecha;
			fecha.textContent = fechaLegible;

			const btnEliminar = document.createElement('button');
			btnEliminar.type = 'button';
			btnEliminar.className = 'btn-eliminar';
			btnEliminar.setAttribute('aria-label', 'Eliminar esta entrada');
			btnEliminar.innerHTML = SVG_PAPELERA;
			btnEliminar.addEventListener('click', () => {
				documentIdPendienteEliminar = entrada.documentId;
				modal.hidden = false;
			});

			cabecera.appendChild(emoji);
			cabecera.appendChild(fecha);
			cabecera.appendChild(btnEliminar);

			const cuerpo = document.createElement('p');
			cuerpo.className = 'tarjeta-extracto';
			cuerpo.textContent = extracto;

			tarjeta.appendChild(cabecera);
			tarjeta.appendChild(cuerpo);

			const etiquetas = entrada.etiquetas ?? [];
			if (etiquetas.length > 0) {
				const lista = document.createElement('ul');
				lista.className = 'tarjeta-etiquetas';
				for (const et of etiquetas) {
					const chip = document.createElement('li');
					chip.className = 'chip-etiqueta';
					chip.textContent = et.nombre;
					if (et.color) chip.style.background = et.color;
					lista.appendChild(chip);
				}
				tarjeta.appendChild(lista);
			}

			return tarjeta;
		}

		async function cargarHistorial() {
			try {
				const res = await fetch(
					`${API}/entradas-diario?filters[usuarioId][$eq]=${usuarioId}&sort=fecha:desc&populate=etiquetas`
				);
				const json = await res.json();
				const entradas = json.data ?? [];

				listaEntradas.querySelectorAll('.tarjeta-diario').forEach((el) => el.remove());
				historialVacio.hidden = entradas.length > 0;

				for (const entrada of entradas) {
					listaEntradas.appendChild(construirTarjeta(entrada));
				}
			} catch (error) {
				console.error('No se pudo cargar el historial:', error);
			}
		}

		// --- Guardar nueva entrada ---
		btnGuardar.addEventListener('click', async () => {
			const texto = textoEntrada.value.trim();
			if (!emocionSeleccionada) {
				mostrarEstado('Elige primero cómo te sientes hoy.');
				return;
			}
			if (!texto) {
				mostrarEstado('Escribe algo antes de guardar.');
				return;
			}

			btnGuardar.disabled = true;
			try {
				const res = await fetch(`${API}/entradas-diario`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						data: {
							usuarioId,
							fecha: new Date().toISOString(),
							emocion: emocionSeleccionada,
							texto,
							etiquetas: Array.from(etiquetasSeleccionadas),
						},
					}),
				});

				if (res.ok) {
					textoEntrada.value = '';
					etiquetasSeleccionadas.clear();
					selectorEtiquetas
						.querySelectorAll('.chip-seleccionable.seleccionada')
						.forEach((el) => el.classList.remove('seleccionada'));
					document
						.querySelectorAll('#selector-emocion .opcion-emocion.seleccionada')
						.forEach((el) => {
							el.classList.remove('seleccionada');
							el.setAttribute('aria-checked', 'false');
						});
					emocionSeleccionada = null;
					mostrarEstado('Entrada guardada.');
					await cargarHistorial();
				} else {
					mostrarEstado('No se pudo guardar. Inténtalo de nuevo.');
				}
			} catch (error) {
				console.error('Error al guardar la entrada:', error);
				mostrarEstado('No hay conexión. Inténtalo de nuevo.');
			} finally {
				btnGuardar.disabled = false;
			}
		});

		// --- Eliminación con confirmación (RD-01) ---
		btnCancelarEliminar.addEventListener('click', () => {
			documentIdPendienteEliminar = null;
			modal.hidden = true;
		});

		btnConfirmarEliminar.addEventListener('click', async () => {
			const documentId = documentIdPendienteEliminar;
			documentIdPendienteEliminar = null;
			modal.hidden = true;
			if (!documentId) return;

			try {
				const res = await fetch(`${API}/entradas-diario/${documentId}`, { method: 'DELETE' });
				if (res.ok) {
					const tarjeta = listaEntradas.querySelector(`[data-document-id="${documentId}"]`);
					if (tarjeta) tarjeta.remove();
					if (!listaEntradas.querySelector('.tarjeta-diario')) {
						historialVacio.hidden = false;
					}
				} else {
					mostrarEstado('No se pudo eliminar. Inténtalo de nuevo.');
				}
			} catch (error) {
				console.error('Error al eliminar la entrada:', error);
				mostrarEstado('No hay conexión. Inténtalo de nuevo.');
			}
		});

		cargarEtiquetas();
		cargarHistorial();
	})();
</script>

<script>
	import { logout } from '../lib/auth';

	// Mostrar nombre del usuario en la barra de sesión
	const raw = localStorage.getItem('yanapaway_firebase_user');
	if (raw) {
		try {
			const u = JSON.parse(raw);
			const el = document.getElementById('barra-sesion-nombre');
			if (el) el.textContent = u.displayName ?? u.email ?? '';
		} catch {}
	}

	// Cerrar sesión
	document.getElementById('btn-cerrar-sesion').addEventListener('click', async () => {
		await logout();
		location.reload();
	});
</script>

<style is:global>
	.diario-wrapper {
		background: var(--color-bg-soft);
		padding-block: 2.5rem 3.5rem;
	}

	/* Tarjeta de login centrada — sin sesión */
	.login-gate-centrado {
		display: flex;
		justify-content: center;
		padding-block: 4rem;
	}

	.login-gate-centrado[hidden] {
		display: none;
	}

	.login-card-centrada {
		background: var(--color-bg);
		border-radius: 1.5rem;
		padding: 2.5rem 2rem;
		text-align: center;
		max-width: 24rem;
		box-shadow: 0 4px 20px rgba(26, 29, 33, 0.08);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
	}

	.login-card-icon {
		font-size: 2.2rem;
	}

	.login-card-centrada h2 {
		font-size: 1.25rem;
		font-weight: 600;
	}

	.login-card-centrada p {
		font-size: 0.88rem;
		color: var(--color-ink-soft);
		line-height: 1.5;
	}

	/* Barra de sesión compacta — con sesión activa */
	.barra-sesion {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		background: var(--color-bg);
		border-radius: 1rem;
		padding: 0.55rem 1.1rem;
		margin-bottom: 1.5rem;
		box-shadow: 0 1px 3px rgba(26, 29, 33, 0.06);
	}

	.barra-sesion[hidden] {
		display: none;
	}

	.barra-sesion-nombre {
		font-size: 0.85rem;
		color: var(--color-ink);
		flex: 1;
	}

	.btn-logout {
		background: transparent;
		color: var(--color-ink-soft);
		border: 1.5px solid var(--color-ink-soft);
		padding: 0.35rem 0.9rem;
		font-size: 0.78rem;
		cursor: pointer;
		border-radius: 999px;
		font-family: inherit;
	}

	.btn-logout:hover {
		background: var(--color-bg-soft);
	}

	.barra-sesion-icon {
		font-size: 1rem;
	}

	.diario-layout {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 1.5rem;
		align-items: start;
	}

	/* Panel de nueva entrada */
	.nueva-entrada {
		background: var(--color-bg);
		border-radius: 1.5rem;
		padding: 2rem;
		box-shadow: 0 2px 10px rgba(26, 29, 33, 0.07);
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.nueva-entrada h2 {
		font-size: 1.35rem;
		font-weight: 600;
	}

	#texto-entrada {
		width: 100%;
		min-height: 9rem;
		border: 2px solid var(--color-primary);
		border-radius: 1rem;
		padding: 0.9rem 1.1rem;
		font-family: inherit;
		font-size: 0.95rem;
		line-height: 1.6;
		resize: vertical;
	}

	#texto-entrada:focus {
		outline: none;
		border-color: var(--color-primary-light);
	}

	.selector-etiquetas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.chip-etiqueta {
		font-size: 0.78rem;
		padding: 0.3rem 0.8rem;
		border-radius: 999px;
		background: var(--color-support-teal-tint);
		color: var(--color-ink-soft);
	}

	.chip-seleccionable {
		border: 2px solid transparent;
		cursor: pointer;
		font-family: inherit;
		transition: border-color 0.15s ease;
	}

	.chip-seleccionable.seleccionada {
		border-color: var(--color-primary);
		color: var(--color-ink);
		font-weight: 600;
	}

	.acciones-entrada {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	#btn-guardar {
		background: var(--color-primary);
		color: #ffffff;
		padding: 0.85rem 2rem;
		font-size: 0.95rem;
		font-weight: 600;
		border-radius: 999px;
		transition: background 0.2s ease;
	}

	#btn-guardar:hover:not(:disabled) {
		background: var(--color-primary-light);
	}

	#btn-guardar:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}

	.mensaje-estado {
		font-size: 0.85rem;
		color: var(--color-support-brown);
	}

	.modulos-nav {
		display: flex;
		gap: 0.5rem;
	}

	.nav-modulo {
		background: var(--color-support-teal-tint);
		color: var(--color-ink);
		padding: 0.6rem 1.1rem;
		font-size: 0.82rem;
		text-align: center;
	}

	/* Historial */
	.historial-entradas {
		background: var(--color-support-teal-tint);
		border-radius: 1.5rem;
		padding: 1.75rem;
	}

	.historial-entradas h3 {
		font-size: 1.1rem;
		font-weight: 600;
		margin-bottom: 1.25rem;
	}

	.lista-entradas {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-height: 34rem;
		overflow-y: auto;
	}

	.historial-vacio {
		font-size: 0.88rem;
		color: var(--color-ink-soft);
		line-height: 1.5;
	}

	/* Tarjetas del historial (generadas por JS) */
	.tarjeta-diario {
		background: var(--color-bg);
		border-radius: 1rem;
		padding: 1rem 1.25rem;
		box-shadow: 0 1px 4px rgba(26, 29, 33, 0.08);
	}

	.tarjeta-cabecera {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.5rem;
	}

	.tarjeta-emoji {
		font-size: 1.3rem;
		line-height: 1;
	}

	.tarjeta-fecha {
		font-size: 0.82rem;
		color: var(--color-support-brown);
		text-transform: capitalize;
	}

	.btn-eliminar {
		margin-inline-start: auto;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border: none;
		background: transparent;
		color: var(--color-ink-soft);
		cursor: pointer;
		padding: 0.35rem;
		border-radius: 0.5rem;
		transition: background 0.15s ease;
	}

	.btn-eliminar:hover {
		background: var(--color-bg-soft);
	}

	.tarjeta-extracto {
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--color-ink);
	}

	.tarjeta-etiquetas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.6rem;
	}

	.tarjeta-etiquetas .chip-etiqueta {
		font-size: 0.72rem;
	}

	/* Modal de confirmación — tonos neutros, sin rojos (RD-01) */
	.modal-eliminar {
		position: fixed;
		inset: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(26, 29, 33, 0.45);
		padding: 1.5rem;
	}

	.modal-eliminar[hidden] {
		display: none;
	}

	.modal-caja {
		background: var(--color-bg);
		border-radius: 1.5rem;
		padding: 1.75rem;
		max-width: 22rem;
