---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import TarjetaHistoria from '../../components/blog/TarjetaHistoria.astro';
import {
  CATEGORIAS_HISTORIA,
  esCategoriaValida,
  listarHistorias,
  type Historia,
  type Paginacion,
} from '../../lib/historias';

export const prerender = false;

const parametros = Astro.url.searchParams;
const categoriaPedida = parametros.get('categoria') ?? '';
const categoriaSeleccionada = esCategoriaValida(categoriaPedida) ? categoriaPedida : '';
const paginaPedida = Number.parseInt(parametros.get('pagina') ?? '1', 10);
const pagina = Number.isFinite(paginaPedida) && paginaPedida > 0 ? paginaPedida : 1;

// Igual que /recursos: la página existe con o sin CMS. Si el CMS no responde,
// se degrada a la versión sin historias en lugar de tirar un 500 — es un
// espacio de apoyo y quedarse sin nada es el peor resultado.
let historias: Historia[] = [];
let paginacion: Paginacion = { pagina, totalPaginas: 1, total: 0 };
let cmsCaido = false;

try {
  const resultado = await listarHistorias(pagina, categoriaSeleccionada || undefined);
  historias = resultado.historias;
  paginacion = resultado.paginacion;
} catch (error) {
  cmsCaido = true;
  console.error('[blog] No se pudieron cargar las historias desde el CMS:', error);
}

function enlaceListado(cambios: { categoria?: string; pagina?: number }): string {
  const params = new URLSearchParams();
  const categoria = cambios.categoria ?? categoriaSeleccionada;
  const paginaDestino = cambios.pagina ?? 1;

  if (categoria) {
    params.set('categoria', categoria);
  }
  if (paginaDestino > 1) {
    params.set('pagina', String(paginaDestino));
  }

  const query = params.toString();
  return query ? `/blog?${query}` : '/blog';
}
---

<Layout
  title="Historias — yanapaway"
  description="Un espacio anónimo donde mujeres que salieron de una situación de violencia comparten su experiencia y acompañan a otras."
>
  <Navbar rutaActiva="/blog" />

  <section class="hero-blog">
    <div class="wrapper">
      <h1>Historias</h1>
      <p>
        Mujeres que atravesaron una situación de violencia y hoy están mejor cuentan cómo fue.
        Nadie firma con su nombre: cada historia aparece con un seudónimo que se genera solo.
      </p>
      <a class="pill-btn" href="/blog/nueva">Compartir mi historia</a>
    </div>
  </section>

  <div class="wrapper contenido-blog">
    <nav class="filtros" aria-label="Filtrar historias por tema">
      <a href={enlaceListado({ categoria: '' })} aria-current={!categoriaSeleccionada ? 'page' : undefined}>
        Todas
      </a>
      {
        CATEGORIAS_HISTORIA.map((categoria) => (
          <a
            href={enlaceListado({ categoria: categoria.valor })}
            aria-current={categoriaSeleccionada === categoria.valor ? 'page' : undefined}
          >
            {categoria.etiqueta}
          </a>
        ))
      }
    </nav>

    {
      cmsCaido ? (
        <div class="aviso-cms">
          <p>
            En este momento no podemos mostrar las historias. Es un problema nuestro, no tuyo, y ya
            estamos trabajando en resolverlo.
          </p>
          <p>
            Si necesitas ayuda ahora, el <a href="/instituciones">directorio de instituciones</a> y el{' '}
            <a href="/asistente">asistente</a> siguen disponibles.
          </p>
        </div>
      ) : historias.length === 0 ? (
        <p class="sin-historias">
          {categoriaSeleccionada
            ? 'Todavía no hay historias publicadas sobre este tema.'
            : 'Todavía no hay historias publicadas. Puedes ser la primera voz de este espacio.'}
        </p>
      ) : (
        <section class="lista-historias">
          {historias.map((historia) => (
            <TarjetaHistoria historia={historia} />
          ))}
        </section>
      )
    }

    {
      paginacion.totalPaginas > 1 && (
        <nav class="paginacion" aria-label="Paginación de historias">
          {pagina > 1 ? (
            <a href={enlaceListado({ pagina: pagina - 1 })} rel="prev">
              ← Anterior
            </a>
          ) : (
            <span />
          )}

          <span class="pagina-actual">Página {paginacion.pagina} de {paginacion.totalPaginas}</span>

          {pagina < paginacion.totalPaginas ? (
            <a href={enlaceListado({ pagina: pagina + 1 })} rel="next">
              Siguiente →
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </div>

  <Footer />
</Layout>

<style>
  .hero-blog {
    background: var(--color-support-teal-tint);
    padding-block: 3.25rem;
  }

  .hero-blog h1 {
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 700;
    color: var(--color-ink);
  }

  .hero-blog p {
    margin-top: 0.85rem;
    max-width: 58ch;
    color: var(--color-ink-soft);
    line-height: 1.65;
  }

  .hero-blog .pill-btn {
    margin-top: 1.5rem;
  }

  .contenido-blog {
    padding-block: 2.5rem 4.5rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 820px;
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filtros a {
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-bg-soft);
    color: var(--color-ink-soft);
    text-decoration: none;
    font-size: 0.85rem;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .filtros a:hover {
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
  }

  .filtros a[aria-current='page'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
    font-weight: 600;
  }

  .lista-historias {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .sin-historias {
    color: var(--color-ink-soft);
    line-height: 1.6;
  }

  .paginacion {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.9rem;
  }

  .paginacion a {
    color: var(--color-primary-dark);
    font-weight: 600;
    text-decoration: none;
  }

  .paginacion a:hover {
    text-decoration: underline;
  }

  .pagina-actual {
    color: var(--color-ink-soft);
  }

  .aviso-cms {
    background: var(--color-red-soft);
    border-left: 4px solid var(--color-red);
    border-radius: var(--radius-m);
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    line-height: 1.6;
    color: var(--color-ink);
    max-width: 62ch;
  }

  .aviso-cms a {
    color: var(--color-secondary);
    font-weight: 500;
  }
</style>
