---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { formatearFecha } from '../../lib/fechas';
import {
  etiquetaDeCategoria,
  listarComentarios,
  obtenerHistoriaPorId,
  type ComentarioHistoria,
  type Historia,
} from '../../lib/historias';
import { esIdValido } from '../../lib/validation';

export const prerender = false;

const id = Astro.params.id;

let historia: Historia | null = null;
let comentarios: ComentarioHistoria[] = [];
let cmsCaido = false;

if (id && esIdValido(id)) {
  try {
    historia = await obtenerHistoriaPorId(id);
    if (historia) {
      comentarios = await listarComentarios(id);
    }
  } catch (error) {
    cmsCaido = true;
    console.error('[blog] No se pudo cargar la historia desde el CMS:', error);
  }
}

// Una historia pendiente de moderación y una inexistente son el mismo caso
// para quien visita: 404 en los dos, sin distinguirlos.
if (!historia && !cmsCaido) {
  return new Response(null, { status: 404, statusText: 'Historia no encontrada' });
}

const CONTENIDO_MAX = 2000;
---

<Layout
  title={historia ? `Historia de ${historia.alias} — yanapaway` : 'Historias — yanapaway'}
  description="Una historia compartida de forma anónima por una mujer que atravesó una situación de violencia."
>
  <Navbar rutaActiva="/blog" />

  <div class="wrapper contenido-historia">
    <a class="volver" href="/blog">← Volver a las historias</a>

    {
      cmsCaido || !historia ? (
        <div class="aviso-cms">
          <p>
            En este momento no podemos mostrar esta historia. Es un problema nuestro, no tuyo, y ya
            estamos trabajando en resolverlo.
          </p>
          <p>
            Si necesitas ayuda ahora, el <a href="/instituciones">directorio de instituciones</a> y el{' '}
            <a href="/asistente">asistente</a> siguen disponibles.
          </p>
        </div>
      ) : (
        <>
          <article class="historia">
            <div class="meta">
              <span class="alias">{historia.alias}</span>
              <time datetime={historia.creadaEn}>{formatearFecha(historia.creadaEn)}</time>
            </div>

            <span class="categoria">{etiquetaDeCategoria(historia.categoria)}</span>

            <p class="cuerpo">{historia.contenido}</p>
          </article>

          <section class="apoyos">
            <h2>
              Mensajes de apoyo
              <span class="conteo">({comentarios.length})</span>
            </h2>

            <form id="form-comentario" class="formulario-comentario" data-historia-id={historia.id}>
              <label for="contenido-comentario" class="sr-only">
                Tu mensaje de apoyo
              </label>
              <textarea
                id="contenido-comentario"
                rows="3"
                minlength="2"
                maxlength={CONTENIDO_MAX}
                placeholder="Escribe un mensaje de apoyo. También se revisa antes de publicarse."
                required></textarea>

              <button type="submit" class="pill-btn">Enviar apoyo anónimo</button>

              <p id="mensaje-estado" class="mensaje-estado" role="status" aria-live="polite"></p>
            </form>

            {comentarios.length === 0 ? (
              <p class="sin-apoyos">Todavía no hay mensajes publicados. Puedes ser la primera.</p>
            ) : (
              <ul class="lista-apoyos">
                {comentarios.map((comentario) => (
                  <li class="apoyo">
                    <div class="meta">
                      <span class="alias">{comentario.alias}</span>
                      <time datetime={comentario.creadaEn}>{formatearFecha(comentario.creadaEn)}</time>
                    </div>
                    <p>{comentario.contenido}</p>
                  </li>
                ))}
              </ul>
            )}
          </section>
        </>
      )
    }
  </div>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('form-comentario');
  const textarea = document.getElementById('contenido-comentario');
  const mensaje = document.getElementById('mensaje-estado');

  if (form instanceof HTMLFormElement && textarea instanceof HTMLTextAreaElement && mensaje) {
    const historiaId = form.dataset.historiaId;
    const boton = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();

      if (boton instanceof HTMLButtonElement) {
        boton.disabled = true;
      }
      mensaje.textContent = '';
      mensaje.className = 'mensaje-estado';

      try {
        const respuesta = await fetch(`/api/blog/historias/${historiaId}/comentarios`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contenido: textarea.value }),
        });

        const datos = await respuesta.json();

        if (!respuesta.ok) {
          throw new Error(datos.error || 'No pudimos enviar tu mensaje.');
        }

        // No se recarga la página: el mensaje todavía no está publicado, así
        // que recargar solo mostraría la lista igual que antes y daría la
        // impresión de que el envío falló.
        mensaje.textContent = `Recibimos tu mensaje y quedará firmado como "${datos.alias}". Aparecerá cuando el equipo lo revise.`;
        mensaje.classList.add('exito');
        form.reset();
      } catch (error) {
        mensaje.textContent = error instanceof Error ? error.message : 'No pudimos enviar tu mensaje.';
        mensaje.classList.add('error');
      } finally {
        if (boton instanceof HTMLButtonElement) {
          boton.disabled = false;
        }
      }
    });
  }
</script>

<style>
  .contenido-historia {
    padding-block: 2.5rem 4.5rem;
    max-width: 720px;
  }

  .volver {
    color: var(--color-ink-soft);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .volver:hover {
    color: var(--color-primary-dark);
  }

  .historia {
    margin-top: 1.25rem;
    background: var(--color-bg);
    border: 1px solid var(--color-bg-soft);
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-soft);
    padding: 1.75rem;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: 0.82rem;
    color: var(--color-ink-soft);
  }

  .alias {
    font-weight: 600;
    color: var(--color-primary-dark);
  }

  .categoria {
    display: inline-block;
    margin-top: 0.7rem;
    background: var(--color-support-teal-tint);
    color: var(--color-primary-dark);
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    font-size: 0.78rem;
  }

  .cuerpo {
    margin-top: 1rem;
    line-height: 1.75;
    color: var(--color-ink);
    /* Los párrafos son de quien escribió la historia: se respetan tal cual. */
    white-space: pre-wrap;
  }

  .apoyos {
    margin-top: 3rem;
  }

  .apoyos h2 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .conteo {
    font-weight: 400;
    color: var(--color-ink-soft);
  }

  .formulario-comentario {
    margin-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  textarea {
    font-family: inherit;
    font-size: 1rem;
    padding: 0.75rem 0.85rem;
    border-radius: var(--radius-m);
    border: 1px solid var(--color-placeholder);
    background: var(--color-bg);
    color: var(--color-ink);
    resize: vertical;
  }

  textarea:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
  }

  .pill-btn {
    align-self: flex-start;
    border: none;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.95rem;
  }

  .pill-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .mensaje-estado:empty {
    display: none;
  }

  .mensaje-estado {
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .mensaje-estado.exito {
    background: var(--color-support-teal-tint);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-m);
    padding: 0.9rem 1.1rem;
    color: var(--color-ink);
  }

  .mensaje-estado.error {
    background: var(--color-red-soft);
    border-left: 4px solid var(--color-red);
    border-radius: var(--radius-m);
    padding: 0.9rem 1.1rem;
    color: var(--color-ink);
  }

  .sin-apoyos {
    color: var(--color-ink-soft);
  }

  .lista-apoyos {
    margin-top: 1.5rem;
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .apoyo {
    background: var(--color-bg);
    border: 1px solid var(--color-bg-soft);
    border-radius: var(--radius-m);
    padding: 1rem 1.15rem;
  }

  .apoyo p {
    margin-top: 0.4rem;
    line-height: 1.65;
    color: var(--color-ink);
    white-space: pre-wrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
