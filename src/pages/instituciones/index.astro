---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BuscadorInstituciones from '../../components/directorio/BuscadorInstituciones.astro';
import MapaInstituciones from '../../components/directorio/MapaInstituciones.astro';
import TarjetaInstitucion from '../../components/directorio/TarjetaInstitucion.astro';
import { db } from '../../db/client';
import { tiposCaso as tablaTiposCaso } from '../../db/schema';
import { listarInstituciones, type TipoInstitucion } from '../../db/queries/instituciones';

export const prerender = false;

const tipoParam = Astro.url.searchParams.get('tipo') || undefined;
const tipoCasoParam = Astro.url.searchParams.get('tipo_caso') || undefined;

const [instituciones, tiposCaso] = await Promise.all([
  listarInstituciones({
    tipo: tipoParam as TipoInstitucion | undefined,
    tipoCasoId: tipoCasoParam,
  }),
  db.select().from(tablaTiposCaso),
]);
---

<Layout
  title="Directorio institucional — yanapaway"
  description="Encuentra instituciones que atienden grooming, sextorsión, control digital y violencia en el noviazgo."
>
  <Header />

  <section class="hero-directorio">
    <div class="wrapper">
      <h1>Encuentra apoyo cerca de ti</h1>
      <p>
        Instituciones que atienden grooming, sextorsión, control digital y violencia en el
        noviazgo. No estás sola.
      </p>
    </div>
  </section>

  <div class="wrapper">
    <BuscadorInstituciones
      tiposCaso={tiposCaso}
      tipoSeleccionado={tipoParam}
      tipoCasoSeleccionado={tipoCasoParam}
    />

    <div class="contenido-principal">
      <div class="lista-resultados">
        <p class="conteo-resultados">
          {instituciones.length}{' '}
          {instituciones.length === 1 ? 'institución encontrada' : 'instituciones encontradas'}
        </p>

        {
          instituciones.length === 0 ? (
            <p class="sin-resultados">
              No encontramos instituciones con esos filtros. Prueba con otro tipo o tipo de caso.
            </p>
          ) : (
            <div class="tarjetas">
              {instituciones.map((institucion) => (
                <TarjetaInstitucion institucion={institucion} />
              ))}
            </div>
          )
        }
      </div>

      <MapaInstituciones />
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .hero-directorio {
    background: linear-gradient(135deg, var(--color-green), #156049);
    color: #fff;
    padding: 2.5rem 0 4.5rem;
  }

  .hero-directorio h1 {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .hero-directorio p {
    margin-top: 0.5rem;
    max-width: 60ch;
    opacity: 0.92;
  }

  .contenido-principal {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 1.5rem;
    padding-block: 2rem 3rem;
    align-items: start;
  }

  .conteo-resultados {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    margin-bottom: 0.9rem;
  }

  .sin-resultados {
    color: var(--color-ink-soft);
    background: #fff;
    border-radius: var(--radius-l);
    padding: 1.5rem;
    text-align: center;
  }

  .tarjetas {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  @media (max-width: 900px) {
    .contenido-principal {
      grid-template-columns: 1fr;
    }
  }
</style>
